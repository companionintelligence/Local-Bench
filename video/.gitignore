# rendered videos — regenerate with `ci-video render`
out/

# generated compositions — regenerate with `ci-video build`.
# build/<fmt>/assets is a symlink to ../../assets, which must not be committed.
build/

# playwright auth state
.auth/

node_modules/

# Captured screenshots. These WERE deliberately committed (#38), with the note
# that it should be revisited "once ./video/make.sh --capture works everywhere" —
# the concern being that a fresh clone could not otherwise render the video at
# all, since `ci-video check` fails on missing shots by design.
#
# That condition is now met for this repo: ./video/make.sh builds the app,
# starts the server, captures both scenarios, checks and renders from a clean
# checkout. So the original argument applies again — they are regenerable
# inputs, and a committed screenshot that nothing refreshes goes on looking
# current long after the UI has moved, which is worse than having none.
assets/shots/

# npm install writes this; the project has never had one and both make.sh and
# the workflow use `npm install`, so committing it now would quietly change how
# the video toolchain resolves.
package-lock.json
