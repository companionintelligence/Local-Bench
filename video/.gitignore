# rendered videos — regenerate with `ci-video render`
out/

# generated compositions — regenerate with `ci-video build`.
# build/<fmt>/assets is a symlink to ../../assets, which must not be committed.
build/

# playwright auth state
.auth/

node_modules/

# assets/shots/ is deliberately NOT ignored — screenshots are committed inputs.
#
# Fleet-wide policy, 2026-08-05. Ignoring them was defensible while this repo's
# own ./video/make.sh worked end to end, but only three of the twelve products
# have a working stage. A gitignored shot set therefore means nobody but the
# stage's author can render the cut, and eleven of twelve were rendering as
# branded "capture pending" slates — a green build with no product in it.
#
# The staleness concern that motivated the ignore is real and is handled the
# other way round: when you change a screen the video covers, re-run the
# matching capture pass and commit the new PNGs in the same PR.

# npm install writes this; the project has never had one and both make.sh and
# the workflow use `npm install`, so committing it now would quietly change how
# the video toolchain resolves.
package-lock.json
