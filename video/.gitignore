# rendered videos — regenerate with `ci-video render`
out/

# generated compositions — regenerate with `ci-video build`.
# build/<fmt>/assets is a symlink to ../../assets, which must not be committed.
build/

# playwright auth state
.auth/

node_modules/

# NOTE: captured screenshots are deliberately COMMITTED, not ignored. The
# argument for ignoring them — that they are regenerable inputs and a stale
# screenshot outlives the UI it shows — is sound in principle, but today only a
# few repos have a working local stage recipe. Ignoring them here would mean a
# fresh clone cannot render this video at all, and `ci-video check` fails on
# missing shots by design. Revisit once `./video/make.sh --capture` works
# everywhere.

# npm install writes this; the project has never had one and both make.sh and
# the workflow use `npm install`, so committing it now would quietly change how
# the video toolchain resolves.
package-lock.json
