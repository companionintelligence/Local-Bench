{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-local-bench",
    "name": "Local Bench",
    "repo": "companionintelligence/Local-Bench",
    "marketplaceId": "ci-local-bench",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5,
    "pacing": "fit",
    "pacingTail": 0.15
  },
  "chapters": {
    "setup": "First run",
    "benchmark": "Run a benchmark",
    "compare": "Compare models",
    "docs": "Documentation"
  },
  "media": {
    "music": "assets/media/ci-campaign-bed-110.mp3",
    "musicLufs": -22
  },
  "master": [
    "someone-elses-hardware",
    {
      "ref": "where-people-quit",
      "items": [
        {
          "label": "How you choose",
          "value": "parameter count"
        },
        {
          "label": "How you verify",
          "value": "you don't"
        },
        {
          "label": "What you learn",
          "value": "nothing"
        }
      ]
    },
    "open",
    {
      "ref": "needs-ollama",
      "caption": "Nothing installed yet. The catalog still reads.",
      "transition": "dissolve"
    },
    {
      "ref": "models-installed",
      "caption": "It reads what you have pulled. Two of forty-two."
    },
    {
      "ref": "pick-a-prompt",
      "caption": "Pick a prompt. Edit it. Run that exact text.",
      "narration": "Pick a prompt, edit it, and run that exact text against the selected models."
    },
    {
      "ref": "run-it",
      "caption": "Every selected model gets the same prompt."
    },
    {
      "ref": "benchmark-complete",
      "caption": "The run finishes here. Two models, measured.",
      "narration": "A benchmark finishes on the Ollama host you selected, with the result saved for comparison.",
      "transition": "hold"
    },
    {
      "ref": "system-specs",
      "caption": "Not a datacentre. This machine, on this run.",
      "narration": "Every result records the processor, memory, and graphics hardware behind the run."
    },
    {
      "ref": "response-compare",
      "caption": "Fast is not the same as good.",
      "narration": "Speed is only half the question. Compare what each model actually wrote."
    },
    {
      "ref": "model-intelligence",
      "caption": "Ranked by an index, not by parameter count.",
      "narration": "Use the intelligence table as context before you download another model."
    },
    {
      "ref": "read-the-docs",
      "caption": "Even the documentation is local."
    },
    {
      "ref": "recap",
      "caption": "Measured on your hardware, stored on your disk.",
      "narration": "Selected models run through Ollama, and the results live in a local SQLite file.",
      "transition": "dissolve"
    },
    {
      "ref": "close",
      "cta": "Benchmark before you commit",
      "tagline": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "Benchmark before you commit with Local Bench. Visit ci dot computer. UnCloud your life."
    }
  ],
  "scenes": [
    {
      "id": "someone-elses-hardware",
      "kind": "feature",
      "seconds": 7,
      "title": "Benchmarked on a machine you don't own",
      "caption": "A leaderboard tells you what is fast in a datacentre.",
      "narration": "Every leaderboard you have read measures someone else's hardware, in a datacentre you will never see.",
      "items": [
        {
          "label": "Where it ran",
          "value": "a datacentre"
        },
        {
          "label": "What it measured",
          "value": "their hardware"
        },
        {
          "label": "What you have",
          "value": "a box in a closet"
        }
      ],
      "reveal": "paced"
    },
    {
      "id": "where-people-quit",
      "kind": "feature",
      "seconds": 6,
      "title": "Most people quit right about here",
      "caption": "Pick by parameter count. Hope it fits. Never check.",
      "narration": "So you choose by parameter count, hope it fits, and never find out what your own machine can do.",
      "items": [
        {
          "label": "How you choose",
          "value": "parameter count"
        },
        {
          "label": "How you verify",
          "value": "you don't"
        }
      ],
      "reveal": "paced",
      "transition": "cut"
    },
    {
      "id": "open",
      "kind": "intro",
      "seconds": 5,
      "title": "Local Bench",
      "caption": "Benchmark the models you actually run.",
      "narration": "This one measures yours. Forty-two curated models, fourteen prompts, on the box you already have.",
      "mark": "./assets/app-icon.png",
      "reveal": "paced",
      "transition": "hold"
    },
    {
      "id": "first-run",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 7,
      "caption": "One page. No account, no telemetry, no cloud.",
      "narration": "One page, no account. The whole catalog is browsable before you install anything.",
      "shots": [
        {
          "id": "dashboard-hero",
          "url": "local-bench-living-room-server-acme.ci.computer",
          "alt": "Local Bench dashboard: hero copy and four summary cards for catalog size, installed models, top intelligence score and fastest measured model.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitUntil": "networkidle",
            "waitFor": "#modelCatalogSummary .tag",
            "settle": 450
          },
          "focus": {
            "landscape": {
              "x": 0.14,
              "y": 0,
              "w": 0.72,
              "h": 0.42
            },
            "portrait": {
              "x": 0.02,
              "y": 0.06,
              "w": 0.96,
              "h": 0.94
            }
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "needs-ollama",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 7,
      "caption": "Forty-two curated models. No daemon yet, and it says so.",
      "narration": "Local Bench talks to Ollama. With no daemon running, it shows the catalog and says so.",
      "shots": [
        {
          "id": "model-catalog",
          "url": "local-bench-living-room-server-acme.ci.computer",
          "alt": "The model picker: curated Ollama models as selectable cards, the installed and curated counts, and the notice that Ollama is not reachable.",
          "motion": "pull-back",
          "capture": {
            "path": "/",
            "waitUntil": "networkidle",
            "waitFor": "#modelCatalogSummary .note.warn",
            "before": [
              {
                "eval": "(() => { document.getElementById('modelCatalogSummary').scrollIntoView({ block: 'center' }); })()"
              }
            ],
            "settle": 450
          },
          "focus": {
            "landscape": {
              "x": 0.16,
              "y": 0.42,
              "w": 0.685,
              "h": 0.16
            },
            "portrait": {
              "x": 0.06,
              "y": 0.39,
              "w": 0.88,
              "h": 0.22
            }
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "models-installed",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 7,
      "caption": "Start the daemon. What you have pulled unlocks.",
      "narration": "Start Ollama and the catalog comes alive. Anything you have already pulled becomes selectable.",
      "shots": [
        {
          "id": "models-installed",
          "url": "local-bench-living-room-server-acme.ci.computer",
          "alt": "The model picker with Ollama connected: the installed catalog models sort to the top with enabled checkboxes, above the disabled cards for models not pulled locally.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitUntil": "networkidle",
            "waitFor": "#modelList .model-opt:not(.disabled) input:not([disabled])",
            "before": [
              {
                "eval": "(() => { const bar = document.querySelector('.topbar').getBoundingClientRect().height; const label = document.getElementById('modelList').previousElementSibling; window.scrollTo(0, label.getBoundingClientRect().top + window.scrollY - bar - 14); })()"
              }
            ],
            "settle": 450
          },
          "focus": {
            "landscape": {
              "x": 0.145,
              "y": 0.09,
              "w": 0.71,
              "h": 0.3
            },
            "portrait": {
              "x": 0.02,
              "y": 0,
              "w": 0.96,
              "h": 0.9
            }
          },
          "pointer": {
            "landscape": {
              "x": 0.311,
              "y": 0.155
            },
            "portrait": {
              "x": 0.876,
              "y": 0.169
            }
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "pick-a-prompt",
      "kind": "screen",
      "chapter": "benchmark",
      "seconds": 6.5,
      "caption": "Pick a prompt. Edit it. That exact text runs.",
      "narration": "Pick a prompt. The box below it is editable, and that exact text is what runs.",
      "shots": [
        {
          "id": "prompt-picker",
          "url": "local-bench-living-room-server-acme.ci.computer",
          "alt": "The test prompt dropdown, its category and description, and the editable textarea holding the prompt that will be sent to the model.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitUntil": "networkidle",
            "waitFor": "#activePrompt",
            "before": [
              {
                "waitFor": "#promptLibrary .prompt-card"
              },
              {
                "eval": "(() => { document.getElementById('activePrompt').scrollIntoView({ block: 'center' }); })()"
              }
            ],
            "settle": 450
          },
          "focus": {
            "landscape": {
              "x": 0.12,
              "y": 0.02,
              "w": 0.76,
              "h": 0.76
            },
            "portrait": {
              "x": 0.02,
              "y": 0.02,
              "w": 0.96,
              "h": 0.94
