          },
          "pointer": {
            "landscape": {
              "x": 0.834,
              "y": 0.345
            },
            "portrait": {
              "x": 0.911,
              "y": 0.272
            }
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "browse-prompts",
      "kind": "screen",
      "chapter": "benchmark",
      "seconds": 6,
      "caption": "Fourteen prompts, each tagged with the work it tests.",
      "narration": "Fourteen prompts, from coding to operations. Expand one to read it first.",
      "shots": [
        {
          "id": "prompt-library",
          "url": "local-bench-living-room-server-acme.ci.computer",
          "alt": "The prompt library grid with the first card expanded to reveal the full prompt text that will be sent to the model.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitUntil": "networkidle",
            "waitFor": "#promptLibrary .prompt-card",
            "before": [
              {
                "click": "#promptLibrary .prompt-card:first-child .prompt-card-toggle"
              },
              {
                "waitFor": "#promptLibrary .prompt-card.expanded .prompt-card-text"
              },
              {
                "eval": "(() => { const bar = document.querySelector('.topbar').getBoundingClientRect().height; const label = document.getElementById('promptLibrary').previousElementSibling; window.scrollTo(0, label.getBoundingClientRect().top + window.scrollY - bar - 14); })()"
              }
            ],
            "settle": 450
          },
          "focus": {
            "landscape": {
              "x": 0.14,
              "y": 0.06,
              "w": 0.72,
              "h": 0.3
            },
            "portrait": {
              "x": 0.02,
              "y": 0.02,
              "w": 0.96,
              "h": 0.5
            }
          },
          "pointer": {
            "landscape": {
              "x": 0.311,
              "y": 0.157
            },
            "portrait": {
              "x": 0.881,
              "y": 0.197
            }
          }
