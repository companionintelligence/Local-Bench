      "transition": "cut"
    },
    {
      "id": "system-specs",
      "kind": "screen",
      "chapter": "benchmark",
      "seconds": 7,
      "caption": "Every result is stamped with the machine that made it.",
      "narration": "Every result is stamped with the machine that produced it. Processor, memory, graphics.",
      "shots": [
        {
          "id": "system-specs",
          "url": "local-bench-living-room-server-acme.ci.computer",
          "alt": "The System specifications card: server name, CPU model, core and thread counts, memory, operating system, motherboard and detected GPU.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitUntil": "networkidle",
            "waitFor": "#systemSpecs .specs-grid",
            "before": [
              {
                "eval": "(() => { document.getElementById('systemSpecs').closest('.section').scrollIntoView({ block: 'end' }); window.scrollBy(0, 28); })()"
